<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="/css/style.css">
<i class="bi bi-check-circle-fill text-success fs-1"></i>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>QR Generated</title>
</head>
<body>

<div class="hero">

    <div class="card-modern text-center" id="qrCard">

        <div class="d-flex justify-content-end mb-3">

            <button id="themeToggle"
                    class="btn btn-outline-secondary btn-sm">
            </button>

        </div>

        <div class="mb-3">
            <span class="badge bg-dark px-3 py-2">
                Vehicle Detected
            </span>
        </div>

        
        <h1>Scan QR Code</h1>

        <p class="text-muted">
            Scan this QR code to continue login
        </p>

        <img
            id="qrImage"
            src="<%= qr %>"
            class="img-fluid my-4"
            style="max-width:250px;">

        <small class="text-muted">
            Session Token
        </small>

        <p id="token" class="fw-bold">
            <%= token %>
        </p>

        <button
            class="btn btn-dark"
            onclick="copyToken()">
            Copy Token
        </button>

        <div class="mt-4">

    <div class="mt-4" id="statusBox">

    <div class="spinner-border text-success"
         role="status">
    </div>

    <p class="mt-3">
        Waiting for Mobile Authentication...
    </p></div>

    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>

<script>

anime({
    targets:'#qrCard',
    opacity:[0,1],
    translateY:[50,0],
    duration:1000,
    easing:'easeOutExpo'
});

anime({
    targets:'#qrImage',
    scale:[0.8,1],
    duration:1200,
    easing:'easeOutElastic(1,.6)'
});

function copyToken()
{
    navigator.clipboard.writeText(
        document.getElementById("token").innerText
    );

    alert("Token copied!");
}

</script>
<script>

const toggleBtn =
document.getElementById("themeToggle");

// Load saved theme
if(localStorage.getItem("theme") === "dark")
{
    document.body.classList.add("dark-mode");

    toggleBtn.innerHTML = "☀️ Light Mode";
}
else
{
    toggleBtn.innerHTML = "🌙 Dark Mode";
}

toggleBtn.addEventListener("click", () => {

    document.body.classList.toggle("dark-mode");

    if(document.body.classList.contains("dark-mode"))
    {
        localStorage.setItem("theme","dark");
        toggleBtn.innerHTML = "☀️ Light Mode";
    }
    else
    {
        localStorage.setItem("theme","light");
        toggleBtn.innerHTML = "🌙 Dark Mode";
    }

});

anime({
    targets: '.spinner-border',
    scale: [1, 1.1],
    direction: 'alternate',
    loop: true,
    easing: 'easeInOutSine',
    duration: 800
});

</script>

<script>

setInterval(async () => {

    const res = await fetch("/status");
    const data = await res.json();

    if(data.paymentDone)
    {
        document.getElementById("statusBox").innerHTML = `
            <h3 class="text-success">
                DONE ✓
            </h3>

            <p>
                Payment Successful
            </p>

            <p>
                Gate Opened
            </p>
        `;
    }

}, 1000);

</script>


</body>
</html>